# --- Auth ---
AUTH_MODE=password
AUTH_PASSWORD=changeme

# --- System ---
TZ=Asia/Taipei
PUID=1001
PGID=100

# --- Agent ---
AGENT_RUNTIME=claude
CLAUDE_ARGS=--dangerously-skip-permissions

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# --- Workspace Git Sync ---
WORKSPACE_GIT_SYNC_ENABLED=true
WORKSPACE_GIT_SYNC_INTERVAL=60
WORKSPACE_GIT_TOKEN=
WORKSPACE_GIT_SYNC_NOTIFY_CHANNEL=
WORKSPACE_GIT_SYNC_SUBMODULES=false

# --- GitLab OAuth (Chat UI) ---
# 在 GitLab > Settings > Applications 新增 OAuth App
# Redirect URI: https://<your-domain>/auth/callback，Scopes: read_user
GITLAB_URL=https://gitlab.example.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=https://perch.example.com/auth/callback
# 用於簽署 session cookie，正式環境請設隨機值：openssl rand -hex 32
COOKIE_SECRET=
